# Copy to .env and fill in. NEVER commit .env.
NODE_ENV=development
PORT=5100
# MongoDB (must be a replica set – Atlas clusters are). Leave empty for an in-memory replica set.
MONGODB_URI=
DATABASE_URL=
CLIENT_ORIGIN=http://localhost:5174
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
SERVER_ENC_KEY=
ACCESS_TTL_SEC=900
REFRESH_TTL_DAYS=30
DEFAULT_QUOTA_BYTES=10737418240
# Storage: local (default, disk), mongodb (chunks collection in the same MongoDB) or s3 (AWS S3 / Cloudflare R2 / Backblaze B2)
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
SEED_DEMO=0
LOG_LEVEL=info
